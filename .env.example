# ============================================================
# Performance Command Center — Required Credentials
# ============================================================
# Copy this to packages/web/.env.local and fill in your values.
# The dashboard works in 3 modes:
#   1. DEMO MODE: No creds needed — runs on seeded sample data (run: npm run seed)
#   2. LIVE META ONLY: Just META_ADS_ACCESS_TOKEN + DATABASE_URL
#   3. FULL LIVE: All credentials below
# ============================================================

# --- Database (required for all modes) ---
DATABASE_URL=postgresql://localhost:5432/perf_marketing

# --- Meta Ads API ---
# Get from: developers.facebook.com → Marketing API → Graph API Explorer
# Scope needed: ads_read, ads_management
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=act_XXXXXXXXXX

# --- Google Ads API ---
# Step 1: Create OAuth client at console.cloud.google.com → APIs → Credentials → Desktop App
# Step 2: Get developer token from ads.google.com → Tools → API Center
# Step 3: Run `python3 get_refresh_token.py` (set env vars first) to get refresh token
#         Sign in with the Google account that has access to your Ads MCC
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_IDS=

# --- LLM Gateway (for AI Brain/Agent features) ---
ANTHROPIC_API_KEY=
# Optional: If using Razorpay's LLM Gateway proxy
# ANTHROPIC_BASE_URL=https://llm-gateway.razorpay.com
# ANTHROPIC_CUSTOM_HEADERS=x-litellm-api-key: Bearer <key>

# --- DataGaaru (for backend conversion data refresh) ---
# Only needed if you want to refresh backend data from Trino
# Get Datum token from: datum-v2.razorpay.com → Generate Auth Token
# DATAGAARU_EMAIL=your-email@razorpay.com
# DATAGAARU_DATUM_TOKEN=
