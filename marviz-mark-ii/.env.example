# Marviz Mark II — Voice AI Agent for Ad Analytics
# Copy to .env and fill in credentials

# --- Claude / Anthropic (required) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Gemini STT (required for voice, optional for text-only) ---
# Get from: aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-flash-lite-latest

# --- Google Ads (required) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# --- Meta Ads (required) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXXX

# --- Safety ---
WRITE_ACTIONS_ENABLED=false
CONFIRMATION_TIMEOUT_SECONDS=30
MAX_TOOL_ITERATIONS=8
